{
  "name": "gnuradio4",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined",
    "--ulimit",
    "nofile=1024:4096"
  ],
  "workspaceMount": "source=${localWorkspaceFolder}/,target=/gnuradio4/,type=bind",
  "workspaceFolder": "/gnuradio4",
  "customizations": {
    "vscode": {
      "extensions": [
        "vadimcn.vscode-lldb",
        "llvm-vs-code-extensions.vscode-clangd",
        "mhutchie.git-graph",
        "Gruntfuggly.todo-tree",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "workbench.colorTheme": "Visual Studio Light"
      }
    }
  },
  "remoteUser": "ubuntu"
}
